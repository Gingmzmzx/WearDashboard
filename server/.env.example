# API token for the agent plugin / DeepSeek harness.
API_TOKEN=change-me-api-token

# Seeds one watch/phone device on first start. Issue per-device tokens via
# POST /api/v1/devices for normal use.
WATCH_TOKEN=change-me-watch-token

SERVER_NAME=agent-gateway
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
REQUEST_TTL_SECONDS=120
QUESTION_TTL_SECONDS=300
EXPIRY_INTERVAL_SECONDS=1.0

# Off by default; prefer the Authorization header.
ALLOW_QUERY_TOKEN=false

# Comma-separated browser origins, if a web UI calls this API.
CORS_ORIGINS=
